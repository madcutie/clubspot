# Dirección de la API. En desarrollo se puede omitir: cae a http://localhost:5037.
# En el build de producción es obligatoria, sin barra final, y no puede apuntar a esta máquina.
VITE_API_URL=http://localhost:5037

# Sólo para revisar el bundle de producción contra la API local (npm run build && npm run preview).
# No va en un deploy real.
# VITE_ALLOW_LOCAL_API=1
