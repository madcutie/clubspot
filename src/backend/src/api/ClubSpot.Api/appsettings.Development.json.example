{
  "ConnectionStrings": {
    "ClubSpot": "Host=localhost;Port=5432;Database=clubspot;Username=postgres;Password=clubspot"
  },
  "Payments": {
    "Provider": "fake",
    "MercadoPago": {
      "AccessToken": "",
      "WebhookSecret": "",
      "RequireValidSignature": false
    }
  },
  "Jwt": {
    "Issuer": "ClubSpot.Development",
    "Audience": "ClubSpot.Backoffice",
    "SigningKey": "development-only-signing-key-must-be-32-characters"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
